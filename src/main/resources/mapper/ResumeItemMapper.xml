<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.blog.mapper.ResumeItemMapper">

    <!-- 新增条目 -->
    <insert id="insert" parameterType="com.example.blog.entity.ResumeItem" useGeneratedKeys="true" keyProperty="id">
        insert into resume_item(section_id, content, sort_order, created_at)
        values(#{sectionId}, #{content}, #{sortOrder}, NOW())
    </insert>

    <!-- 根据ID查询单个条目 -->
    <select id="selectById" resultType="com.example.blog.entity.ResumeItem">
        select * from resume_item where id = #{id}
    </select>

    <!-- 查询某模块下的所有条目，按 sort_order 升序 -->
    <select id="selectBySectionId" resultType="com.example.blog.entity.ResumeItem">
        select * from resume_item where section_id = #{sectionId} order by sort_order asc
    </select>

    <!-- 更新条目内容，使用动态SQL只更新非空字段 -->
    <update id="update" parameterType="com.example.blog.entity.ResumeItem">
        update resume_item
        <set>
            <if test="content != null">content = #{content},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
        </set>
        where id = #{id}
    </update>

    <!-- 删除单个条目 -->
    <delete id="deleteById">
        delete from resume_item where id = #{id}
    </delete>

    <!-- 删除某模块下的所有条目（用于级联删除模块时） -->
    <delete id="deleteBySectionId">
        delete from resume_item where section_id = #{sectionId}
    </delete>

    <!-- 删除某简历下的所有条目（用于级联删除简历时）
         通过子查询找到该简历下所有模块的ID，再删除关联的条目 -->
    <delete id="deleteByResumeId">
        delete from resume_item where section_id in (select id from resume_section where resume_id = #{resumeId})
    </delete>

</mapper>
