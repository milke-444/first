<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.blog.mapper.BlogCommentMapper">
    <select id="list" parameterType="com.example.blog.model.dto.ListCommenDto" resultType= "com.example.blog.model.dto.CommentTreeDto">
        select email,comment_body,comment_create_time,comment_status,reply_body,reply_create_time,comment_id,blog_id,admin_id
        from blog_comment
        where is_deleted = 0 and parent_id IS null and blog_id = #{blogId}/*定义了博客表下评论的组合索引，使用blog_id和is_deleted可以快速查询*/
        order by comment_create_time desc
        <if test="page != null and page > 0">
            limit #{start},#{pageSize}
        </if>

    </select>

    <insert id="saveComment" parameterType="com.example.blog.model.dto.BlogCommentSaveDto">
       insert into blog_comment(blog_id,comment_body,admin_id)
       values(#{blogId},#{commentBody},#{adminId})

    </insert>

    <insert id="saveCommentReply" parameterType="com.example.blog.model.dto.BlogCommentSaveReply">
        insert into blog_comment(blog_id,reply_body,admin_id,parent_id)
        values(#{blogId},#{replyBody},#{adminId},#{parentId})
    </insert>


</mapper>
