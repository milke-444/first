<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.blog.mapper.BlogCategoryMapper">
    <select id="list" parameterType="com.example.blog.dto.ListDto" resultType="com.example.blog.entity.BlogCategory">
        select * from blog_category
        where is_deleted = 0
        order by category_rank desc
        <if test="page != null and page > 0">
            limit #{start},#{pageSize}
        </if>

    </select>
    <insert id="save" parameterType="com.example.blog.entity.BlogCategory">
        insert into
        blog_category(category_name,category_icon,category_rank,create_time,update_time)
        values(#{categoryName},#{categoryIcon},#{categoryRank},NOW(),NOW())

    </insert>
    <update id="update" parameterType="com.example.blog.entity.BlogCategory">
        update blog_category
        <set>
            <if test="categoryName != null and categoryName !=''">
                category_name = #{categoryName},
            </if>
            <if test="categoryIcon != null and categoryIcon !=''" >
                category_icon = #{categoryIcon},
            </if>
                 update_time = NOW()
        </set>
        where category_id = #{categoryId}

    </update>

</mapper>
