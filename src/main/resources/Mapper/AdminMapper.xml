<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.blog.mapper.AdminMapper">
    <insert id="adminRegister" parameterType="com.example.blog.entity.Admin">
insert into admin(admin_name,admin_password,admin_account)
values(#{adminName},#{adminPassword},#{adminAccount})
    </insert>




</mapper>
